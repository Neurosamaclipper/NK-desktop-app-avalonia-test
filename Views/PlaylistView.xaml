<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:NeuroKaraokeAvaloniaPlayer.ViewModels"
             xmlns:models="clr-namespace:NeuroKaraokeAvaloniaPlayer.Models"
             xmlns:converters="clr-namespace:NeuroKaraokeAvaloniaPlayer.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NeuroKaraokeAvaloniaPlayer.Views.PlaylistView">
    <UserControl.DataContext>
        <viewModels:PlaylistViewModel/>
    </UserControl.DataContext>

    <DockPanel Margin="20">
        
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 20">
            <TextBlock Text="Public Playlists"
                       FontSize="24"
                       FontWeight="Bold"/>
            <Button Content="Refresh"
                    Width="80"
                    Margin="20 0 0 0"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>

        
        <Grid ColumnDefinitions="2*, 3*" ColumnSpacing="20">
            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Playlists"
                           Grid.Row="0"
                           FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <ListBox ItemsSource="{Binding Playlists}"
                         Grid.Row="1"
                         DoubleTapped="OnPlaylistDoubleTapped"
                         SelectedItem="{Binding SelectedPlaylist}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Playlist">
                            <Border Padding="10" Margin="0 0 0 5"
                                    Background="{DynamicResource ThemeAccentBrush}"
                                    CornerRadius="4">
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                    <TextBlock Text="{Binding Name}"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SongCount}"
                                               Grid.Column="1"
                                               Width="60"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlayCount}"
                                               Grid.Column="2"
                                               Width="60"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FavoriteCount}"
                                               Grid.Column="3"
                                               Width="60"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Load Playlist"
                        Grid.Row="2"
                        Height="30"
                        Margin="0 10 0 0"
                        Command="{Binding LoadPlaylistCommand}"
                        IsEnabled="{Binding CanLoadPlaylist}"/>
            </Grid>

            
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Songs in Playlist"
                           Grid.Row="0"
                           FontWeight="Bold"
                           Margin="0"/>

                <DataGrid ItemsSource="{Binding PlaylistSongs}"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          DoubleTapped="OnSongDoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Artist"
                                            Binding="{Binding OriginalArtists, Converter={StaticResource ArtistsToStringConverter}}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Plays"
                                            Binding="{Binding PlayCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Duration"
                                            Binding="{Binding Duration, Converter={StaticResource DurationToStringConverter}}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>